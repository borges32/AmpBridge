# Database Configuration
DATABASE_URL=postgresql+asyncpg://opamp:opamp_password@postgres:5432/opamp_db

# OpAMP Server Configuration
OPAMP_SERVER_URL=http://opamp-server:4321
OPAMP_SYNC_INTERVAL_SECONDS=60

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=OpAMP Backend API
DEBUG=false

# Logging Configuration
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# LOG_SYNC_OPERATIONS: Enable/disable sync operation detailed logs (default: true)
# Set to false in production to reduce log volume
LOG_SYNC_OPERATIONS=true

# LOG_HTTP_REQUESTS: Enable/disable HTTP request logs from httpx (default: false)
LOG_HTTP_REQUESTS=false

# Agent Sync Strategy
# USE_HOSTNAME_AS_SYNC_KEY: Use host_name instead of instance_id for agent identification (default: false)
# When enabled:
# - Agents are matched by host_name during sync
# - instance_id is updated if it changes
# - All related records (health, configs, pipelines) are updated to maintain relationships
# Useful for containerized environments where instance_id changes frequently
USE_HOSTNAME_AS_SYNC_KEY=false
