# Application environment
APP_ENV=dev

# Database configuration
DB_URL=sqlite:///data/app.db
# For PostgreSQL: DB_URL=postgresql://opamp:opamp_password@postgres:5432/opamp

# Admin user credentials (bootstrap user)
ADMIN_USER=admin
ADMIN_PASS=admin123

# JWT configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_MIN=1440

# OpAMP server configuration
OPAMP_BASE_URL=http://opamp-server:4321

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_PER_MIN=100

# Logging
LOG_LEVEL=INFO

# Optional: OpenTelemetry OTLP configuration
OTLP_ENDPOINT=
OTLP_HEADERS=

# Job processing configuration
MAX_CONCURRENT_JOBS=50
JOB_TIMEOUT_SECONDS=300